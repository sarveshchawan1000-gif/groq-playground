# ==============================================================================
# Aether AI Playground - Environment Configuration Template
# Copy this file to .env.local and populate the keys for the models you want to use.
# NEVER commit real API keys or sensitive credentials to version control.
# ==============================================================================

# Provider API Keys (Server-side only)
# Set your provider keys in .env.local to enable live provider generation.
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Configurable Model IDs (Overrides defaults specified in src/config/models.ts)
# 1. Fast model — optimized for low latency
MODEL_FAST_ID=llama-3.1-8b-instant
MODEL_FAST_PROVIDER=groq

# 2. Reasoning model — optimized for coding and complex tasks
MODEL_REASONING_ID=llama-3.3-70b-versatile
MODEL_REASONING_PROVIDER=groq

# 3. Budget model — optimized for lower-cost use
MODEL_BUDGET_ID=gemma2-9b-it
MODEL_BUDGET_PROVIDER=groq

# 4. Vision model — accepts image input, if supported by the configured provider
MODEL_VISION_ID=llama-3.2-11b-vision-preview
MODEL_VISION_PROVIDER=groq

# Model pricing metadata (optional, in USD per 1M tokens; if omitted, UI shows "unavailable")
# MODEL_FAST_INPUT_COST_PER_M=0.05
# MODEL_FAST_OUTPUT_COST_PER_M=0.08
# MODEL_REASONING_INPUT_COST_PER_M=0.59
# MODEL_REASONING_OUTPUT_COST_PER_M=0.79
# MODEL_BUDGET_INPUT_COST_PER_M=0.07
# MODEL_BUDGET_OUTPUT_COST_PER_M=0.07
# MODEL_VISION_INPUT_COST_PER_M=0.18
# MODEL_VISION_OUTPUT_COST_PER_M=0.18

# Demo / Simulated provider fallback
# When set to true and a provider key is absent, the playground enables a simulated
# streaming response mode so you can test the UI, streaming, metrics, and message flow.
ENABLE_DEMO_MOCK=true
